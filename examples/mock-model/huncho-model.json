{
  "schema_version": "1.0",
  "name": "mock-laya",
  "family": "F1",
  "backbone": {
    "source": { "kind": "hf", "repo": "convaiinnovations/laya", "revision": "mock-reference" },
    "artifacts": {
      "onnx": [{ "path": "mock-model.onnx", "dtype": "fp32" }]
    },
    "hidden_size": 1024,
    "max_context": 8192,
    "tokenizer": "tokenizer.json"
  },
  "head": { "kind": "option-marker", "weights": "mock-head.safetensors", "width": 1 },
  "prompt_contract": {
    "template": "laya-v1",
    "option_marker_tokens": ["<option:0>"],
    "state_budget": 3072,
    "head_budget": 1024,
    "max_options": 255,
    "contract_hash": "f1-mock-contract-hash"
  },
  "calibration": {
    "default": { "temperature": 1.0, "confidence": "peak", "status": "fit" },
    "entries": { "onnx:fp32": { "temperature": 1.0, "confidence": "peak", "status": "fit" } },
    "eval_set_hash": "mock-eval-0001"
  },
  "reference": {
    "family_impl": "huncho-mock-reference",
    "revision": "main",
    "golden": "golden.json"
  },
  "capabilities": {
    "supports_fork": false,
    "supports_multi_lora": false
  }
}
