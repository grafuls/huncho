# huncho serve — env-file example (OPS-03).
#
# These are read by `huncho serve` (clap `env`). Copy to
# /etc/huncho/huncho.env, set the secret, and chmod 600.

# Listener address (default 127.0.0.1:8080). Use 0.0.0.0 to expose to the net.
HUNCHO_BIND=0.0.0.0:8080

# Choose a compatible runtime for each model; an explicit backend is optional.
HUNCHO_BACKEND=auto

# Optional dtype override; omitted by default to use each model's precision.
# HUNCHO_DTYPE=fp32

# Model cache dir (OPS-04), also seeds HF resolution.
HUNCHO_CACHE_DIR=/var/lib/huncho

# REQUIRED in production: bearer token sent as `Authorization: Bearer <token>`.
# Every route requires it, so health probes and Prometheus scrapes must send it.
# Keep this file readable only by the service user.
HUNCHO_AUTH_TOKEN=change-me
