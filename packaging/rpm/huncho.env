# huncho serve — environment file for the packaged systemd unit (OPS-03).
#
# The systemd unit reads this via `EnvironmentFile=-/etc/huncho/huncho.env`.
# Everything here is optional; defaults are safe for local/dev use. Edit to
# match your deployment, then `systemctl restart huncho`.
#
# NOTE: the repo's `deploy/huncho.env` is the production template. This file
# ships with the RPM and switches the default to a local/dev-safe profile.

# Listener address (host:port). 127.0.0.1 keeps the server on loopback;
# use 0.0.0.0 only if the service should be exposed on the network.
HUNCHO_BIND=127.0.0.1:8080

# Choose a compatible runtime for each manifest/model you load.
# The systemd unit serves the built-in mock model by default (`--mock`), so
# this is only used once you point the unit at a real manifest or `--model`.
HUNCHO_BACKEND=auto

# Model cache directory (OPS-04); also seeds Hugging Face resolution.
HUNCHO_CACHE_DIR=/var/lib/huncho

# REQUIRED in production: bearer token sent as `Authorization: Bearer <token>`.
# The default is world-readable (0644) so the service stays usable out of the
# box; if you set a token, restrict this file again, e.g. `chmod 600`.
# HUNCHO_AUTH_TOKEN=change-me
